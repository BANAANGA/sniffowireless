{
 "title": "sniffowireless",
 "uid": "sniffowireless",
 "tags": [
  "sniffowireless",
  "wifi",
  "bluetooth"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "style": "dark",
 "panels": [
  {
   "id": 1,
   "title": "Active devices",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (sniffowireless_devices_active)",
     "legendFormat": "{{kind}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {}
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ap"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#4cc2ff"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "wifi_client"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3ecf8e"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ble"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#f5b84a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "bt_classic"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ef6f6c"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 2,
   "title": "People / groups present",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
