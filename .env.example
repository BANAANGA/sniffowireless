# Copy to .env and adjust. See README.md for every option.

# Comma-separated monitor-capable Wi-Fi adapters (NOT the one your host uses for its own network).
WIFI_INTERFACES=wlan1
# Channels to hop: default (2.4 GHz + common 5 GHz), all (incl. 6 GHz PSCs), 2.4ghz, 5ghz, 6ghz, 6all,
# or a list like 1,6,11,36-48,6g:37. Combine tokens: default,6ghz
WIFI_CHANNELS=default
# Country code for `iw reg set` - most adapters only enable 6 GHz once this is set.
# WIFI_REGDOMAIN=NL
# Per-interface override, e.g. when one adapter is 2.4 GHz only:
# WIFI_CHANNELS_wlan1=1-13
# WIFI_CHANNELS_wlan2=36,40,44,48,149,153,157,161
# WIFI_CHANNELS_wlan3=6ghz

# Wired interfaces for Ethernet / LAN monitoring (ideally on a switch mirror/SPAN port). Empty disables it.
# ETH_INTERFACES=eth1

# Bluetooth adapters (hciconfig / bluetoothctl list). Empty disables Bluetooth.
BT_DEVICES=hci0

# USB Zigbee sticks, by stable path (ls /dev/serial/by-id). Empty disables Zigbee / 802.15.4 monitoring.
# ZIGBEE_DEVICES=/dev/serial/by-id/usb-ITEAD_SONOFF_Zigbee_3.0_USB_Dongle_Plus_V2_...
# ZIGBEE_CHANNELS=15,20,25    # channels to listen on; default all (11-26). One channel catches brief traffic best.

# LoRa receiver (Heltec WiFi LoRa 32 V3 with firmware/lora-sniffer). Empty disables LoRa monitoring.
# LORA_DEVICES=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_...
# LORA_REGION=EU868           # EU868, US915 or ANZ: picks the listening profiles
# LORA_PROFILES=              # override, e.g. meshtastic-eu868,meshcore-eu868,mynet=868.1/125/7/5/0x12

WEB_PORT=8080
# Web login. Leave both empty to create the admin account in the browser on first visit
# (it asks for a one-time setup code printed in: docker compose logs sniffowireless).
# When set, this account is (re)created as admin on every start.
# WEB_USER=admin
# WEB_PASSWORD=a-long-password
# AUTH_DISABLED=0   # 1 = no login at all (only on a fully trusted network)
# Host names/IPs sniffowireless may be reached as (protects against DNS rebinding). Empty = any.
# ALLOWED_HOSTS=sniffowireless.lan,192.168.1.10
# Reverse proxy address(es) whose X-Forwarded-For/-Proto headers are trusted.
# TRUSTED_PROXIES=127.0.0.1

# Remote sensor mode (on a second machine): capture only and forward to the main server.
# Create the sensor under Settings -> Sensors to get the token.
# SNIFFOWIRELESS_MODE=sensor
# SERVER_URL=http://192.168.1.10:8080
# SENSOR_TOKEN=sniffowireless_...

RETENTION_DAYS=30
TZ=Europe/Amsterdam

# Set to 1 to explore the UI with synthetic data and no radios.
DEMO_MODE=0
