# Copy to .env and adjust. See README.md for every option.

# Comma-separated monitor-capable Wi-Fi adapters (NOT the one your host uses for its own network).
WIFI_INTERFACES=wlan1
# Channels to hop: default (2.4 GHz + common 5 GHz), all, 2.4, 5, or a list like 1,6,11,36-48
WIFI_CHANNELS=default
# Per-interface override, e.g. when one adapter is 2.4 GHz only:
# WIFI_CHANNELS_wlan1=1-13
# WIFI_CHANNELS_wlan2=36,40,44,48,149,153,157,161

# Bluetooth adapters (hciconfig / bluetoothctl list). Empty disables Bluetooth.
BT_DEVICES=hci0

WEB_PORT=8080
# Optional HTTP basic auth for the web UI / API
# WEB_USER=admin
# WEB_PASSWORD=change-me

RETENTION_DAYS=30
TZ=Europe/Amsterdam

# Set to 1 to explore the UI with synthetic data and no radios.
DEMO_MODE=0
